# ─── AI Threat Intelligence SOC Platform 2.0 — Environment Variables ──────────

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=AI Threat Intelligence SOC Platform 2.0
APP_VERSION=2.0.0

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=2743
POSTGRES_DB=threat_detection
DATABASE_URL=postgresql+asyncpg://postgres:SecurePassword123!@localhost:5432/threat_detection

# Redis
REDIS_URL=redis://localhost:6379

# Security — CHANGE THIS IN PRODUCTION!
SECRET_KEY=your-super-secret-key-minimum-32-characters-here

# LLM (optional — mock explanations used when unavailable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional threat intelligence enrichment (defensive lookups only)
ABUSEIPDB_API_KEY=

# ML Detection
ANOMALY_THRESHOLD=0.6
FAILED_LOGIN_THRESHOLD=5
PORT_SCAN_THRESHOLD=20
AUTO_BLOCK_RISK_THRESHOLD=85.0

# Frontend (also see frontend/.env.example)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
